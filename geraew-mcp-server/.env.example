# GeraEW API base URL (no trailing slash). Routes are under /api/v1.
GERAEW_BASE_URL=http://localhost:3000

# Auth — option A: email + password (auto login + refresh, recommended)
GERAEW_EMAIL=you@example.com
GERAEW_PASSWORD=your-password

# Auth — option B: paste a pre-issued token instead of credentials
# GERAEW_ACCESS_TOKEN=eyJ...
# GERAEW_REFRESH_TOKEN=abc123...

# Where generated files are downloaded by default (defaults to cwd)
# GERAEW_DOWNLOAD_DIR=/absolute/path/to/output
